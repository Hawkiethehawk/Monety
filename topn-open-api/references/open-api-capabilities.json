  "configuration_reads": {
    "apps": {"method": "POST", "path": "/v1/apps", "data": ["app_id", "app_name", "platform", "package_name", "category", "sub_category", "store_url", "orientation", "COPPA/CCPA"], "documentation": "https://help.toponad.net/cn/docs/ying-yong-guan-li-xin-ban-v3"},
    "placements": {"method": "POST", "path": "/v1/placements", "data": ["广告位身份、名称、应用、广告样式、状态及已登记配置"], "documentation": "https://help.toponad.net/cn/docs/aqW7tE"},
    "network_accounts": {"method": "GET", "path": "/v1/networks", "data": ["广告平台 Publisher/App 维度账号参数与报表 API 开通信息"], "documentation": "https://help.toponad.net/cn/docs/MKYR3n"},
    "custom_networks": {"method": "GET", "path": "/v1/custom_networks", "data": ["自定义广告平台 Publisher 维度信息"], "documentation": "https://help.toponad.net/cn/docs/MKYR3n"},
    "ad_sources": {"method": "GET", "path": "/v3/units/list", "data": ["广告源列表，可按应用、广告位、广告平台筛选"], "pagination": {"offset": "start", "limit": "limit", "max_limit": 200}, "documentation": "https://help.toponad.net/cn/docs/yj3d9s"},
    "ad_source_details": {"method": "GET", "path": "/v3/units", "data": ["指定广告源详情与第三方广告位参数"], "documentation": "https://help.toponad.net/cn/docs/yj3d9s"},
    "mediation_groups": {"method": "GET", "path": "/v3/mediation_group/:placement_id", "data": ["广告位下的聚合分组、时区等"], "documentation": "https://help.toponad.net/cn/docs/0u4ZH3"},
    "traffic_segments": {"method": "GET", "path": "/v3/mediation_segment/:mediation_group_id", "data": ["流量分组、优先级、匹配规则及状态"], "documentation": "https://help.toponad.net/cn/docs/0u4ZH3"},
    "segment_strategies": {"method": "GET", "path": "/v3/mediation_segment/strategies", "data": ["流量分组高级策略与竞价底价等币种相关属性"], "documentation": "https://help.toponad.net/cn/docs/0u4ZH3"},
    "waterfall_units": {"method": "GET", "path": "/v3/waterfall/:mediation_group_id/segment_id/:segment_id/units", "data": ["启用/关闭广告源、eCPM、自动 eCPM、竞价底价、频控、同价优先级、并发请求数"], "documentation": "https://help.toponad.net/cn/docs/kHxCQb"},
    "waterfall_unit_properties": {"method": "GET", "path": "/v3/waterfall/units", "data": ["广告源在所有 Waterfall 的属性"], "documentation": "https://help.toponad.net/cn/docs/kHxCQb"},
    "abtest_waterfall_units": {"method": "GET", "path": "/v3/waterfall/:mediation_group_id/segment_id/:segment_id/abtest_group_item_id/:abtest_group_item_id/units", "data": ["A/B 测试分组下启用和关闭的广告源及价格/底价"], "documentation": "https://help.toponad.net/cn/docs/kHxCQb"},
    "abtests": {"method": "GET", "path": "/v3/abtest", "data": ["实验 ID、应用、状态、生效时间、实验组权重、广告位和停用选择"], "documentation": "https://help.toponad.net/cn/docs/DRjqiT"},
    "abtest_detail": {"method": "GET", "path": "/v3/abtest/:id", "data": ["单个 A/B 测试完整配置"], "documentation": "https://help.toponad.net/cn/docs/DRjqiT"},
    "reward_rules": {"method": "GET", "path": "/v3/advanced/reward_rule", "data": ["激励规则、回调地址、状态和密钥"], "sensitive": true, "documentation": "https://help.toponad.net/cn/docs/fu-wu-duan-hui-diao-gui-ze"},
    "exchange_rates": {"method": "GET", "path": "/v1/exchange_rate/list", "data": ["指定日期美元兑人民币汇率"], "documentation": "https://help.toponad.net/cn/docs/mei-yuan-zhuan-ren-min-bi-hui-lyu"}
  },
