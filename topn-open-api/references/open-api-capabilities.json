    {
      "rank": 4,
      "source": "user_context",
      "purpose": "解释发布、投放、运营动作等业务事件；作为待验证上下文"
    }
  ],
  "authentication": {
    "headers": ["X-Up-Key", "X-Up-Timestamp", "X-Up-Signature"],
    "signature": "uppercase MD5 of HTTPMethod, Content-MD5, Content-Type, sorted public headers, and resource path joined by newlines",
    "timestamp_valid_minutes": 15,
    "query_string_in_signature_resource": false,
    "documentation": "https://help.toponad.net/cn/docs/9NzgWP"
  },
  "rate_limits": {
    "reporting": {
      "max_concurrency_per_developer": 3,
      "max_per_endpoint_per_minute": 20,
      "max_all_reporting_per_minute": 40,
      "max_all_reporting_per_30_minutes": 300,
      "recommended_mode": "serial",
      "avoid_schedule": "单数小时整点及 40-55 分"
    },
    "management": {
      "max_concurrency_per_developer_per_endpoint": 1,
      "max_per_endpoint_per_minute": 20,
      "max_per_endpoint_per_30_minutes": 200,
      "recommended_mode": "serial"
    },
    "documentation": "https://help.toponad.net/cn/docs/xian-liu-shuo-ming"
  },
  "reporting_datasets": {
    "comprehensive": {
      "role": "primary",
      "method": "POST",
      "path": "/v2/fullreport",
      "url": "https://api.toponad.net/v2/fullreport",
      "date_parameters": ["startdate", "enddate"],
      "filters": ["app_id_list", "placement_id_list", "network_firm_id_list", "adsource_id_list", "area_list"],
      "dimensions": ["date", "app", "placement", "adformat", "area", "network", "adsource", "network_firm_id", "scenario", "traffic_group", "channel", "sdk_version", "app_version", "abtest"],
      "max_group_by_dimensions": 6,
      "metrics": {
        "users": ["dau", "deu", "engaged_rate", "imp_dau", "imp_deu", "dau_launch", "new_users", "new_user_rate", "launch", "per_dau_launch"],
        "estimated_revenue": ["cy_estimate_revenue", "cy_estimate_revenue_ecpm", "estimate_revenue", "estimate_revenue_ecpm", "estimated_revenue_arpdeu", "estimated_revenue_arpu", "per_launch_estimated_revenue"],
        "third_party_api_revenue": ["revenue", "ecpm", "ecpc", "ecpr", "cy_arpu", "arpu", "ecpm_api", "unit_ecpc", "unit_ecpr", "full_app_revenue"],
        "bidding": ["bid_request", "bid_filled_request_rate", "bid_filled_request_ecpm", "waterfall_win", "waterfall_win_rate"],
        "funnel": ["load", "loads_filled", "load_fillrate", "request", "request_filled", "fillrate", "impression", "impression_rate", "click", "ctr"],
        "ready": ["ready_request", "ready_rate", "scenario_entry", "scenario_entry_ready_rate"],
        "third_party_api_counts": ["request_api", "fillrate_api", "impression_api", "click_api", "ctr_api"],
        "gaps": ["revenue_gap", "ecpm_gap", "impression_gap", "click_gap"],
        "latency": ["load_cost_time", "request_cost_time"],
        "other": ["day2_retention", "per_launch_impression", "per_launch_click"]
      },
      "pagination": {"offset": "start", "limit": "limit", "max_limit": 1000, "total": "count"},
      "freshness": {
        "topon_same_day": "约每 10 分钟更新",
        "third_party_t_minus_1": "约每 2 小时更新，通常比后台晚 2-3 小时",
        "permission_warmup": "开通报表 API 后约 2-3 小时才开始返回数据",
        "history_boundary": "通常只能取得开通日前推 10 天及之后的数据"
      },
      "important_constraints": [
        "group_by 包含 scenario、traffic_group、channel、sdk_version 或 app_version 时，不返回第三方 API 指标及相关收益/GAP 指标",
        "DAU、新用户、流量请求、广告场景等指标受 group_by 和筛选条件限制，缺失不等于数值为零",
        "estimate_revenue 已标注后续下线，优先使用 cy_estimate_revenue 并显式请求 USD",
        "历史数据通常不更新，日常增量建议重拉最近 2 天"
      ],
      "documentation": "https://help.toponad.net/cn/docs/dukFyc"
    },
    "hourly": {
      "role": "primary_intraday",
      "method": "POST",
      "path": "/v3/report/tk_hour",
      "url": "https://api.toponad.net/v3/report/tk_hour",
      "date_parameters": ["start_date", "end_date"],
      "filters": ["app_id_list", "placement_id_list", "scenario_list", "adformat_list", "segment_id_list", "network_id_list", "adsource_id_list", "geo_short_list", "sdk_version_list", "app_version_list", "platform_list", "device_type_list", "channel_list"],
      "dimensions": ["date", "hour"],
      "metrics": ["loads", "load_fill_rate", "request", "request_fill_rate", "impression", "impression_rate", "click", "click_rate", "estimated_revenue", "estimated_revenue_ecpm", "launch"],
      "required_context": ["currency", "time_zone"],
      "max_date_span_days": 10,
      "pagination": {"offset": "start", "limit": "limit", "max_limit": 1000, "total": "count"},
      "freshness": "正常约每 5 分钟更新",
      "documentation": "https://help.toponad.net/cn/docs/1frPcq"
    },
    "ltv_1_60": {
      "role": "primary_cohort",
      "method": "POST",
      "path": "/v3/ltvreport",
      "url": "https://api.toponad.net/v3/ltvreport",
      "filters": ["appid_list", "area_list", "channel_list"],
      "dimensions": ["date", "app", "area", "channel", "device"],
      "metrics": ["new_user", "ltv_day_1...ltv_day_60"],
      "metric_semantics": "ltv_day_N 是该新增用户 cohort 第 N 天总收益；除以 new_user 才对应后台的人均 LTV",
      "device_constraint": "device 维度仅支持 iOS；iOS 与 Android 同传时只返回 iOS",
      "pagination": {"offset": "start", "limit": "limit", "max_limit": 1000, "total": "count"},
      "freshness": "只能查询 T-1 及更早数据，建议 UTC+8 晚 10 点重拉昨天",
      "documentation": "https://help.toponad.net/cn/docs/LTV-160-tian-shu-ju"
    },
    "retention_2_60": {
      "role": "primary_cohort",
      "method": "POST",
      "path": "/v3/retentionreport",
      "url": "https://api.toponad.net/v3/retentionreport",
      "filters": ["appid_list", "area_list", "channel_list"],
      "dimensions": ["date", "app", "area", "channel", "device"],
      "metrics": ["new_user", "retention_day_2...retention_day_60"],
      "metric_semantics": "retention_day_N 是留存人数，不是留存率；留存率需除以 new_user",
      "device_constraint": "device 维度仅支持 iOS；iOS 与 Android 同传时只返回 iOS",
      "pagination": {"offset": "start", "limit": "limit", "max_limit": 1000, "total": "count"},
      "freshness": "只能查询 T-1 及更早数据，建议 UTC+8 晚 10 点重拉昨天",
      "documentation": "https://help.toponad.net/cn/docs/liu-cun-260-tian-shu-ju"
    },
    "new_user_impressions_1_60": {
      "role": "primary_cohort",
      "method": "POST",
      "path": "/v3/impnewuserreport",
      "url": "https://api.toponad.net/v3/impnewuserreport",
      "filters": ["app_id_list", "placement_id_list", "geo_short_list", "channel_list"],
      "dimensions": ["date_time", "app_id", "placement_id", "geo_short", "channel"],
      "metrics": ["new_user", "impression_1...impression_60"],
      "metric_semantics": "impression_N 是第 N 天新用户人均展示；乘以 new_user 得到该日 cohort 展示增量",
      "app_constraint": "app_id_list 必传且一次只能传一个应用",
      "pagination": {"offset": "start", "limit": "limit", "max_limit": 1000, "total": "count"},
      "freshness": "延迟 1 天，建议 UTC+8 晚 10 点重拉昨天",
      "documentation": "https://help.toponad.net/cn/docs/zhan-shi-he-xin-zeng-yong-hu-160-tian-shu-ju"
    },
    "device_impression_click": {
      "role": "restricted_granular",
      "method": "GET",
      "path": "/v3/devicereport",
      "url": "https://api.toponad.net/v3/devicereport",
      "parameters": ["day", "app_id", "timezone"],
      "delivery": "返回短期有效的 CSV 下载链接",
      "dimensions": ["placement_id", "placement_name", "placement_format", "android_id", "gaid", "idfa", "idfv", "oaid", "imei", "amazon_id", "set_gaid", "set_imei", "set_oaid", "set_idfa", "user_id", "area", "is_abtest", "traffic_group_id", "segment_id", "segment_name", "network_firm_id", "network_firm", "os_version", "att_status", "device_type", "brand", "model", "app_vn", "app_vc", "new_user_type", "channel", "sub_channel", "scenario_custom_uuid", "scenario_name"],
      "metrics": ["impression", "click", "revenue", "ecpm", "estimate_revenue", "cny_estimate_revenue"],
      "retention_days": 30,
      "permission": "需要联系 TopOn 单独开通",
      "privacy": "包含设备标识、IP/用户标识等敏感数据，必须最小化、脱敏并限制保留",
      "documentation": "https://help.toponad.net/cn/docs/OJPZH2"
    }
  },
  "event_sources": {
