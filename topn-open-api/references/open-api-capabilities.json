    },
    {
      "rank": 2,
      "source": "open_api_configuration_reads",
      "purpose": "主要维度与配置快照：应用、广告位、平台账号、广告源、流量分组、Waterfall、A/B 测试"
    },
    {
      "rank": 3,
      "source": "manual_exports",
